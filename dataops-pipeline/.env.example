# ============================================================
# DataOps Pipeline - Environment Variables
# Copy to .env and fill in real values before running.
# ============================================================

# ---- Airflow Core ----
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags

# ---- Airflow Database (Postgres metastore) ----
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow

# ---- Celery ----
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@postgres/airflow
AIRFLOW__CELERY__BROKER_URL=redis://:@redis:6379/0

# ---- Airflow Webserver ----
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-in-production
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True

# ---- Airflow Connections (JSON format) ----
# MinIO masquerading as AWS S3
AIRFLOW_CONN_AWS_DEFAULT=aws://minioadmin:minioadmin@?endpoint_url=http%3A%2F%2Fminio%3A9000

# Slack webhook connection for alerts
AIRFLOW_CONN_SLACK_DATAOPS=slack://T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# ---- MinIO (S3-compatible local storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000

# ---- AWS CLI env vars pointing to MinIO ----
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://minio:9000

# ---- Bucket Names ----
RAW_BUCKET=raw
BRONZE_BUCKET=bronze
SILVER_BUCKET=silver
GOLD_BUCKET=gold
DOCS_BUCKET=docs

# ---- Slack ----
SLACK_WEBHOOK_URL=<your-slack-webhook-url>

# ---- Great Expectations ----
GE_DATA_DOCS_BUCKET=docs
GE_STORE_BACKEND=s3

# ---- Postgres (used by Airflow metastore) ----
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ---- Spark ----
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
